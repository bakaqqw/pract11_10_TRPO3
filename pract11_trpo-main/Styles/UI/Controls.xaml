<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!--WindowStyle-->
    <Style x:Key="MaterialDesignWindowStyle" TargetType="Window">
        <Setter Property="Height" Value="700"/>
        <Setter Property="Width" Value="800"/>
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <!--PageStyle-->
    <Style x:Key="MaterialDesignPageStyle" TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <!--карточка-->
    <Style x:Key="MaterialDesignCard" TargetType="materialDesign:Card">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="UniformCornerRadius" Value="8"/>
    </Style>

    <!--labelStyle-->
    <Style x:Key="MaterialDesignLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
        <Setter Property="FontSize" Value="14"/>

    </Style>

    <Style x:Key="ErrorContentStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="5,2,0,0"/>
    </Style>

    <Style x:Key="MaterialDesignTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource MaterialDesignValidationErrorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ErrorTextBrush}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource ErrorTextBrush}"/>
                <Setter Property="Margin" Value="0,8,0,20"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--DatePicker-->
    <Style x:Key="MaterialDesignDatePicker" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
        <Setter Property="materialDesign:HintAssist.Hint" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource MaterialDesignValidationErrorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ErrorTextBrush}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource ErrorTextBrush}"/>
                <Setter Property="Margin" Value="0,8,0,20"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MaterialDesignHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="MaterialDesignPrimaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style x:Key="MaterialDesignSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="6"/>
    </Style>


    <Style x:Key="MaterialDesignListView" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>


    <Style x:Key="MaterialDesignMenu" TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>


    <Style x:Key="MaterialDesignStatusBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <ControlTemplate x:Key="MaterialDesignValidationErrorTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <AdornedElementPlaceholder Grid.Row="0"/>
            <TextBlock Grid.Row="1"
            Text="{Binding [0].ErrorContent}" 
            Style="{StaticResource ErrorContentStyle}"
            HorizontalAlignment="Left"
            Margin="8,4,0,0"/>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>