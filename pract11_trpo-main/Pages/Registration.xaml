<Page x:Class="pract9_trpo.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract9_trpo"
      xmlns:validators="clr-namespace:pract9_trpo.Validation"
      mc:Ignorable="d" 
 Style="{StaticResource MaterialDesignPageStyle}"
      d:DesignHeight="550" d:DesignWidth="600"
      Title="Registration">

    <Page.Resources>
        <local:Doctor x:Key="DoctorLogin"/>
    </Page.Resources>

    <Page.DataContext>
        <Binding Source="{StaticResource DoctorLogin}"/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="490"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Left" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
            <TextBlock Text="Регистрация пользователя" FontSize="19" Foreground="{DynamicResource MaterialDesignBody}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="2">
            <Label Content="Имя:" Style="{StaticResource MaterialDesignLabel}"  Margin="0 10 0 34"/>
            <Label Content="Фамилия:" Style="{StaticResource MaterialDesignLabel}"  Margin="0 0 0 34"/>
            <Label Content="Отчество:" Style="{StaticResource MaterialDesignLabel}" Margin="0 0 0 34"/>
            <Label Content="Специализация:" Style="{StaticResource MaterialDesignLabel}" Margin="0 0 0 34"/>
            <Label Content="Придумайте пароль:" Style="{StaticResource MaterialDesignLabel}"  Margin="0 0 0 34"/>
            <Label Content="Подтвердите пароль:" Style="{StaticResource MaterialDesignLabel}" Margin="0 0 0 34"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="2">
            <TextBox Name="name" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="Name" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Name="fam" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="LastName" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Name="otch" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="MiddleName" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
      
            <TextBox Name="spe" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="Specialisation" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            
            <TextBox Name="pass1" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="Password" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
           

            <TextBox Name="pass2" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="Password" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
      
            <Button Content="Зарегистрироваться" HorizontalAlignment="Right" Click="Regestration_Click"  Style="{StaticResource MaterialAccentButton}"/>
            <Button  Content="Назад" HorizontalAlignment="Right" Click="GoBack_Click" Margin="10" Style="{StaticResource MaterialPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Page>
