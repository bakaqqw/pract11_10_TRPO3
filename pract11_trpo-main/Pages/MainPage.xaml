<Page x:Class="pract9_trpo.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract9_trpo"
      mc:Ignorable="d" 
 Style="{StaticResource MaterialDesignPageStyle}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Click="Create_Click" Style="{StaticResource MaterialPrimaryButton}">+</Button>
            <Button  Click="Reseption_Click" Style="{StaticResource MaterialPrimaryButton}">Начать прием</Button>
            <Button  Click="Сhange_Click"   Style="{StaticResource MaterialAccentButton}"  >Изменить</Button>
            <Button Style="{StaticResource MaterialDangerButton}"  Click="Delite_Click" >🗑️</Button>
        </StackPanel>
        <ListView Grid.Row="1"   Background="{DynamicResource MaterialDesignCardBackground}">
            <ListView.ItemTemplate>
                <DataTemplate>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Label Style="{StaticResource MaterialDesignLabel}" Content="Текущий прользователь:" FontSize="20" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom"/>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <Label Content="ID:" Style="{StaticResource MaterialDesignLabel}"/>
            <Label Content="Имя:" Style="{StaticResource MaterialDesignLabel}"/>
            <Label Content="Фамилия:" Style="{StaticResource MaterialDesignLabel}"/>
            <Label Content="Отчество:" Style="{StaticResource MaterialDesignLabel}"/>
            <Label Content="Специализация:" Style="{StaticResource MaterialDesignLabel}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding DoctorInfo.ID}"/>
            <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding DoctorInfo.Name}"/>
            <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding DoctorInfo.LastName}"/>
            <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding DoctorInfo.MiddleName}"/>
            <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding DoctorInfo.Specialisation}"/>
        </StackPanel>

        <ListView Grid.Row="1"  Style="{StaticResource MaterialDesignListView}" ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="Black">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock  Style="{StaticResource MaterialDesignPrimaryText}" Text="Идентификатор: "/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding ID}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock  Style="{StaticResource MaterialDesignPrimaryText}" Text="Имя: "/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding Name}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock  Style="{StaticResource MaterialDesignPrimaryText}" Text="Фамилия: "/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding LastName}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock  Style="{StaticResource MaterialDesignPrimaryText}" Text="Отчество: "/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding MiddleName}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock  Style="{StaticResource MaterialDesignPrimaryText}" Text="Номер телефона: "/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding Number}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock  Style="{StaticResource MaterialDesignPrimaryText}" Text="Дата рождения: "/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding Birthday}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
