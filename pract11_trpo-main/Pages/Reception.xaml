<Page x:Class="pract9_trpo.Reception"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract9_trpo"
      xmlns:validators="clr-namespace:pract9_trpo.Validation"
      xmlns:converters="clr-namespace:pract9_trpo.Class"
      mc:Ignorable="d" 
  Style="{StaticResource MaterialDesignPageStyle}"
      d:DesignHeight="750" d:DesignWidth="900"
      Title="Reception">

    <Page.Resources>
        <converters:LastAppointmentConverter x:Key="lastAppointmentConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource MaterialPrimaryButton}" Content="Назад" HorizontalAlignment="Right" Click="GoBack_Click" />
            <Button Style="{StaticResource MaterialAccentButton}" Click="Change_Click">Изменить информацию</Button>
        </StackPanel>
        <ListView Grid.Row="1" Grid.RowSpan="3" ItemsSource="{Binding patient.AppointmentStories}"  Style="{StaticResource MaterialDesignListView}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="Black" Margin="2" Padding="2">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MaterialDesignPrimaryText}" Text="Последняя дата приема: " FontWeight="Bold"/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding LastAppointment}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MaterialDesignPrimaryText}" Text="Последний врач: " FontWeight="Bold"/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding LastDoctor}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MaterialDesignPrimaryText}" Text="Диагноз: " FontWeight="Bold"/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding Diagnosis}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MaterialDesignPrimaryText}" Text="Рекомендации: " FontWeight="Bold"/>
                                <TextBlock Style="{StaticResource MaterialDesignSecondaryText}" Text="{Binding Recomendations}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Label Style="{StaticResource MaterialDesignLabel}" Content="Прием пациента: " FontSize="16" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3"/>

        <StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="10">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="Возраст пациента: " FontWeight="Bold"/>
                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="{Binding patient.Age, StringFormat={}{0} лет}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="Статус: " FontWeight="Bold"/>
                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="{Binding patient.AgeStatus}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="Последний прием: " FontWeight="Bold"/>
                <TextBlock Text="{Binding patient.LastAppointment}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="Прошло: " FontWeight="Bold"/>
                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="{Binding patient.LastAppointment, 
                    Converter={StaticResource lastAppointmentConverter}}"/>
            </StackPanel>

            <Label Style="{StaticResource MaterialDesignLabel}" Content="Новый прием:" FontWeight="Bold" FontSize="14"/>

            <Label Style="{StaticResource MaterialDesignLabel}" Content="Дата приема:"/>
            <DatePicker Style="{StaticResource MaterialDesignDatePicker}" Name="date" SelectedDate="{Binding newAppointmentStories.LastAppointment, Mode=TwoWay}">
                <DatePicker.Text>
                    <Binding Path="newAppointmentStories.LastAppointment" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </DatePicker.Text>
            </DatePicker>
            

            <Label Content="ID врача:" Style="{StaticResource MaterialDesignLabel}"/>
            <TextBox Style="{StaticResource MaterialDesignTextBox}" Name="doctorID" Text="{Binding DoctorIdDisplay, Mode=OneWay}" IsReadOnly="True"/>
          

            <Label Content="Диагноз:" Style="{StaticResource MaterialDesignLabel}"/>
            <TextBox Name="diag" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="newAppointmentStories.Diagnosis" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <Label Content="Рекомендации:" Style="{StaticResource MaterialDesignLabel}"/>
            <TextBox Name="reco" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="newAppointmentStories.Recomendations" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>


            <Button Style="{StaticResource MaterialAccentButton}" Content="Сохранить" HorizontalAlignment="Right" Click="Save_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>