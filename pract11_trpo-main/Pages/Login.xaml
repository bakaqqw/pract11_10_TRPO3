<Page x:Class="pract9_trpo.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract9_trpo"
      xmlns:validators="clr-namespace:pract9_trpo.Validation"
      mc:Ignorable="d" 
 Style="{StaticResource MaterialDesignPageStyle}"
      d:DesignHeight="450" d:DesignWidth="600"
      Title="Login">

    <Page.Resources>
        <local:Doctor x:Key="DoctorLogin"/>
    </Page.Resources>

    <Page.DataContext>
        <Binding Source="{StaticResource DoctorLogin}"/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="290"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Left" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2">
            <TextBlock Text="Вход пользователя"      Style="{StaticResource MaterialDesignHeaderText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="3">
            <Label Content="Идентификатор:" Style="{StaticResource MaterialDesignLabel}"  Foreground="{DynamicResource LabelForeground}"/>
            <TextBox Name="id" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="ID" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
    
            <Label Content="Пароль:" Style="{StaticResource MaterialDesignLabel}"  Foreground="{DynamicResource LabelForeground}"/>

            <TextBox Name="pass" Style="{StaticResource MaterialDesignTextBox}">
                <TextBox.Text>
                    <Binding Path="Password" Mode="OneWayToSource" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RequiredRule ValidatesOnTargetUpdated="True"></validators:RequiredRule>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
   
            <Button Style="{StaticResource MaterialPrimaryButton}" Content="Войти" HorizontalAlignment="Right" Click="Login_Click" />
            <Button Style="{StaticResource MaterialAccentButton}" Margin="5" Content="Зарегистрироваться" HorizontalAlignment="Right" Click="Redistr_Click" />
        </StackPanel>
    </Grid>
</Page>
